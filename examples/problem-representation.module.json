  "lesson": {
    "blocks": [
      {
        "kind": "heading",
        "text": "A problem as states"
      },
      {
        "kind": "paragraph",
        "text": "An AI search problem identifies the situations an agent can occupy, where it begins, and which states count as success."
      },
      {
        "kind": "paragraph",
        "text": "Actions move the agent between states. A transition model describes how an action changes the current state."
      },
      {
        "kind": "heading",
        "text": "Picture a route"
      },
      {
        "kind": "paragraph",
        "text": "Imagine finding a way from a library to a classroom. Your current location is a state; the library is the initial state, the classroom is a goal state, and each allowed move is an action."
      }
    ]
  },
