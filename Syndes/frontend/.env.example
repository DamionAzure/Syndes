# Frontend environment (Next.js). Copy to `.env.local` and fill in real values.
# `.env*` is gitignored; this `.env.example` is the committed template.
#
# Supabase online module store (spec: supabase-database). ANON KEY ONLY on the
# client — RLS is the real guard, so the anon key is safe to ship. NEVER put the
# Supabase service role key or the GROQ_API_KEY in a NEXT_PUBLIC_* var or anywhere
# the client bundle can read; those are server-side secrets only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
